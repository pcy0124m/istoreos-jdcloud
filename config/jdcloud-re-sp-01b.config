# iStoreOS 配置文件 - 京东云 RE-SP-01B (MT7621)
# 基于 iStoreOS istoreos-24.10 分支
# 精简版 - 目标固件体积 < 22MB
# 主题: Argon
#
# 编译命令: make defconfig 会根据以下配置自动补充依赖

# ===== 目标平台 =====
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y

# ===== 目标设备: 京东云 RE-SP-01B =====
CONFIG_TARGET_ramips_mt7621_DEVICE_jdcloud_re-sp-01b=y

# ===== 构建选项 =====
# 使用 squashfs 文件系统 (高压缩率，减小固件体积)
CONFIG_TARGET_SQUASHFS=y
# 不生成 ext4 (节省编译时间和空间)
# CONFIG_TARGET_EXT4 is not set

# ===== 主题配置 =====
# Argon 主题 (从 diy-part1.sh 添加的 feed 安装)
CONFIG_PACKAGE_luci-theme-argon=y
# Argon 主题设置页面
CONFIG_PACKAGE_luci-app-argon-config=y
# Argon 主题中文翻译
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
# 设为默认主题 (通过 uci defaults 脚本设置)
# 不选 iStoreOS 默认主题以节省空间
# CONFIG_PACKAGE_luci-theme-istoreui is not set
# CONFIG_PACKAGE_luci-theme-istoreui-dark is not set

# ===== iStoreOS 核心组件 (精简) =====
# iStore 软件中心 (保留，核心功能)
CONFIG_PACKAGE_istore=y
CONFIG_PACKAGE_luci-app-istore=y
# iStoreOS 快速向导
CONFIG_PACKAGE_quickstart=y
CONFIG_PACKAGE_luci-app-quickstart=y

# ===== LuCI Web 管理界面 (最小化) =====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
# 精简: 不选 admin-full (减少体积)
# CONFIG_PACKAGE_luci-mod-admin-full is not set

# ===== 防火墙 (最小化) =====
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_iptables-nft=y
# 精简: 不选 iptables-legacy
# CONFIG_PACKAGE_iptables is not set

# ===== DHCP/DNS (最小化) =====
CONFIG_PACKAGE_dnsmasq=y
# 精简: 不选 dnsmasq-dhcpv6 (节省空间)
# CONFIG_PACKAGE_dnsmasq-dhcpv6 is not set
# 精简: 不选 DDNS
# CONFIG_PACKAGE_ddns-scripts is not set
# CONFIG_PACKAGE_luci-app-ddns is not set

# ===== 网络基础协议 =====
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ===== WiFi 驱动 (必须) =====
# MT7603EN (2.4GHz)
CONFIG_PACKAGE_kmod-mt7603=y
# MT7615N (5GHz)
CONFIG_PACKAGE_kmod-mt7615e=y
CONFIG_PACKAGE_kmod-mt7615-firmware=y
# wpad (WPA3 支持，精简版用 wolfssl)
CONFIG_PACKAGE_wpad-wolfssl=y
# 精简: 不用 openssl 版本 (太大)
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set

# ===== 存储支持 (精简) =====
# 基础挂载
CONFIG_PACKAGE_block-mount=y
# 自动挂载
CONFIG_PACKAGE_automount=y
# 文件系统: 仅 ext4 和 vfat (精简)
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
# 精简: 不选 exfat, ntfs3 (节省内核模块空间)
# CONFIG_PACKAGE_kmod-fs-exfat is not set
# CONFIG_PACKAGE_kmod-fs-ntfs3 is not set
# CONFIG_PACKAGE_ntfs-3g is not set
# 精简: 不选 e2fsprogs (太大)
# CONFIG_PACKAGE_e2fsprogs is not set
# 磁盘管理 (精简版)
CONFIG_PACKAGE_luci-app-diskman=y
# 精简: 不选 btrfs 支持
# CONFIG_PACKAGE_luci-app-diskman-btrfs is not set
# CONFIG_PACKAGE_kmod-fs-ksmbd is not set
# CONFIG_PACKAGE_ksmbd-tools is not set

# ===== USB 存储 (必须) =====
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-scsi-core=y

# ===== NAS (精简) =====
# Samba4 文件共享
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y

# ===== 系统维护 (精简) =====
CONFIG_PACKAGE_luci-app-upgrade=y
CONFIG_PACKAGE_luci-app-ttyd=y
# 精简: 不选 systools
# CONFIG_PACKAGE_luci-app-systools is not set
# 精简: 不选 cron (节省空间)
# CONFIG_PACKAGE_cron is not set
# CONFIG_PACKAGE_luci-app-crontab is not set

# ===== 基础工具 (精简) =====
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
# 精简: 不选 bash (用默认 sh 即可)
# CONFIG_PACKAGE_bash is not set
# 精简: 不选 wget-ssl, curl (节省空间)
# CONFIG_PACKAGE_wget-ssl is not set
# CONFIG_PACKAGE_curl is not set
# 精简: 不选 htop, nano, zip 等
# CONFIG_PACKAGE_nano is not set
# CONFIG_PACKAGE_htop is not set
# CONFIG_PACKAGE_zip is not set
# CONFIG_PACKAGE_unzip is not set
# CONFIG_PACKAGE_zstd is not set
# 保留 tar (备份用)
CONFIG_PACKAGE_tar=y

# ===== 内网穿透 (精简) =====
# 精简: 不选 DDNS 内网穿透 (节省空间)
# CONFIG_PACKAGE_luci-app-ddnsto is not set
# CONFIG_PACKAGE_ddnsto is not set

# ===== 内网测速 (精简) =====
# 精简: 不选 homebox (节省空间)
# CONFIG_PACKAGE_luci-app-homebox is not set
# CONFIG_PACKAGE_homebox is not set

# ===== 网络诊断 (精简) =====
# 精简: 不选 netdata (太大，约 2MB+)
# CONFIG_PACKAGE_luci-app-netdata is not set
# CONFIG_PACKAGE_netdata is not set

# ===== IPv6 支持 (精简) =====
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y

# ===== 日志监控 (精简) =====
# 精简: 不选 collectd/statistics (节省大量空间)
# CONFIG_PACKAGE_luci-app-statistics is not set
# CONFIG_PACKAGE_collectd is not set

# ===== MT7621 平台特定 (精简) =====
# 硬件 NAT 加速
CONFIG_PACKAGE_kmod-nft-offload=y
# 网络加速 (精简: 只选 turboacc 界面，不选额外内核模块)
CONFIG_PACKAGE_luci-app-turboacc=y
# 精简: 不选 fast-classifier 和 flowoffload (可选，节省内核空间)
# CONFIG_PACKAGE_kmod-fast-classifier is not set
# CONFIG_PACKAGE_kmod-xt-flowoffload is not set

# ===== 语言/区域 (精简) =====
# 只选必需的中文翻译
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upgrade-zh-cn=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
# 精简: 不选以下翻译
# CONFIG_PACKAGE_luci-i18n-ddns-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-systools-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-crontab-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-netdata-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-homebox-zh-cn is not set

# ===== 系统默认 =====
# 不包含调试信息
# CONFIG_DEBUG is not set
# 精简: 不选 cryptodev (节省空间)
# CONFIG_PACKAGE_kmod-cryptodev is not set

# ===== 网口配置 =====
# MT7621 有 3 个网口，默认第一个为 WAN，其余为 LAN
# VLAN 配置由设备 DTS 文件定义

# ===== 以下为注释掉的选项，按需启用 =====

# --- 科学上网 (默认不包含) ---
# CONFIG_PACKAGE_luci-app-openclash=y
# CONFIG_PACKAGE_luci-app-passwall=y
# CONFIG_PACKAGE_luci-app-ssr-plus=y
# CONFIG_PACKAGE_luci-app-homeproxy=y

# --- Docker ---
# CONFIG_PACKAGE_luci-app-dockerman=y
# CONFIG_PACKAGE_dockerd=y
